# =============================================================================
# clang-format 配置 —— 嵌入式 C（按国内单片机代码习惯调的）
#
# 用法：
#   clang-format -i <文件>              单个文件
#   ctrl+shift+I (VSCode)               当前文件
#   tools/format/format-all.ps1              整个工程（带备份+预览）
#
# 改完这个文件，VSCode 里执行 `clangd: Restart language server` 或重载窗口生效。
# =============================================================================

Language: Cpp

# 基础风格。LLVM 只是起点，下面每一项都按其体需求覆盖了。
BasedOnStyle: LLVM

# -----------------------------------------------------------------------------
# 缩进：Tab，宽度 4（单片机代码的普遍习惯）
# -----------------------------------------------------------------------------
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4

# -----------------------------------------------------------------------------
# 大括号：Allman（大括号独占一行）
#   void foo(void)
#   {
#       ...
#   }
# -----------------------------------------------------------------------------
BreakBeforeBraces: Allman

# -----------------------------------------------------------------------------
# 关键字与括号之间不留空格：if( / while( / for( / switch(
# -----------------------------------------------------------------------------
SpaceBeforeParens: Never

# -----------------------------------------------------------------------------
# 指针星号靠右：uint8_t *p  （而非 uint8_t* p）
# -----------------------------------------------------------------------------
PointerAlignment: Right

# -----------------------------------------------------------------------------
# 列宽限制。
#
# 0 = 不限制，clang-format 不会为了适应列宽而重排已有的换行。
#     对**已有代码**这样最友好：改动集中在缩进/空格/大括号，不会把长表达式
#     重新折行，diff 最小、review 最轻松。
#
# 如果你希望长行自动折行，改成 100 或 120。但注意：对历史代码做这一步会产生
# 大量折行 diff。
# -----------------------------------------------------------------------------
ColumnLimit: 0

# -----------------------------------------------------------------------------
# 短结构不要压成一行（保持可读、便于打断点）
# -----------------------------------------------------------------------------
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# -----------------------------------------------------------------------------
# 对齐
# -----------------------------------------------------------------------------
# 连续赋值/宏定义对齐，看起来整齐；但会改动很多行，按需开启
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: true

# 行尾注释对齐（形如 `x = 1;   // 说明`）
AlignTrailingComments: true

# -----------------------------------------------------------------------------
# 其它
# -----------------------------------------------------------------------------
# 不要自动排序 #include —— 嵌入式里包含顺序经常有依赖，排了会编不过
SortIncludes: Never

# case 标签不额外缩进，和设备厂生成代码保持一致
IndentCaseLabels: false

# #if / #define 顶格，不缩进
IndentPPDirectives: None

# .h/.c 里常见的神奇宏、attribute 不要乱动
BreakBeforeBinaryOperators: None
SpaceAfterCStyleCast: false
