{
  // ───────── CMake ─────────
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.sourceDirectory": "${workspaceFolder}",

  // ───────── clangd：代码补全 / 跳转 / 诊断 ─────────
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**/arm-none-eabi-*",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--pch-storage=memory",
    "--all-scopes-completion"
  ],
  "clangd.checkUpdates": false,
  "clangd.onConfigChanged": "restart",
  // 这里刻意不写 clangd.fallbackFlags。
  //
  // 理由：clangd 对每个文件都是从 build/Debug/compile_commands.json 里取真实参数的
  // （头文件会用"包含它的那个 .c"的参数），所以根本不需要兜底。
  // 而兜底参数一旦写错（比如把 M33 工程写成 -mcpu=cortex-m4 -mfpu=fpv4-sp-d16），
  // 反而会在第一次编译前给出"目标芯片不对"的假报错，比没有兜底更误导。
  //
  // 正确顺序永远是：先 Ctrl+Shift+B 构建一次 → 再让 clangd 索引。

  // ───────── 关掉 Microsoft C/C++ 的 IntelliSense，避免和 clangd 打架 ─────────
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

  // ───────── 文件关联与显示 ─────────
  // 注：CubeMX 生成的启动文件是小写 .s；Windows 文件系统大小写不敏感，
  //     这里只保留一条 `*.s` 即可，避免出现大小写重复的键。
  "files.associations": {
    "*.ld": "linkerscript",
    "*.s": "arm",
    "*.h": "c"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/build": true
  },
  "search.exclude": {
    "**/build": true
  },

  // ───────── 代码格式化（clang-format）─────────
  // 规则在工程根的 .clang-format 里；格式化引擎用 clangd 扩展（它会调用 clang-format）。
  //
  // formatOnSave 默认关闭：这是**故意**的。
  // 老工程第一次全量格式化会改动 70%+ 的行，如果开成"保存即格式化"，
  // 你每改一个字符都会顺手把整个文件重排一遍，git/svn diff 会变得没法 review。
  // 想要的话自己改成 true，但建议先跑一次 "Format All (apply)" 把存量清干净。
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
