# ---- 构建产物 ----
build/
cmake-build-*/
compile_commands.json

# 冒烟测试（tools/check/ci-smoke.sh）在 CI 里生成的临时工程，
# 用来把固件产物留下来做 artifact
ci-out/

# ---- 固件与中间文件 ----
*.elf
*.hex
*.bin
*.map
*.asm
*.o
*.d
*.su

# ---- 调试器 / SVD ----
.svd/*.svd

# ---- 临时 / 草稿文件 ----
# 本地调试用的临时脚本、临时工程统一以 _tmp 开头。
# 留着这一行是有原因的：Windows 上超长路径的目录有时删不掉，
# 有它至少能保证不会被误提交进仓库。清理干净后可以删掉本段。
_tmp*
_kill_tmp*

# ---- 编辑器与系统 ----
.vscode/ipch/
.vscode/*.log
.cache/
.env
.DS_Store
Thumbs.db
